# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.

# Xeno-canto API v3 key — https://xeno-canto.org/account
# Optional: enables Xeno-canto as the primary bird-sound source.
# Without it, bird sounds fall back to iNaturalist observation recordings.
XENO_CANTO_API_KEY=
